<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obsbot_gcs</name>
  <version>0.1.0</version>
  <description>
    Ground-control-station GUI for OBSBOT PTZ cameras: live view with a PTZ
    head-up display, joystick monitor, click-to-point and presets.
  </description>
  <maintainer email="judy293@koreatech.ac.kr">Judy</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>obsbot_ptz</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Only needed when the GCS reads video from an image topic instead of
       opening the camera directly. -->
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
